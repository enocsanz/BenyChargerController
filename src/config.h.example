#define INVERTER_IP "192.168.1.Y"
#define INVERTER_PORT 502
#define INVERTER_SLAVE_ID 1
#define GRID_POWER_REG 37113
#define ACTIVE_POWER_REG 32080
#define HUAWEI_INVERT_POWER true

// ESIOS Token (REE)
